<idea-plugin>
    <id>com.serranofp.alloy-ide</id>
    <name>Alloy Analyzer</name>
    <vendor url="https://serranofp.com">Alejandro Serrano Mena</vendor>
    <description><![CDATA[
        Support for <a href="https://alloytools.org">Alloy</a> 6 models (<code>.als</code> files), with the
        Alloy Analyzer included and running inside the IDE: no separate process or Java installation is needed.
        <ul>
          <li>Diagnostics, hover and quick documentation, go to declaration (also from <code>open</code> paths
              and into the bundled <code>util/*</code> modules), highlight and find usages, rename, structure
              view, breadcrumbs, completion, and <i>Go to Symbol</i></li>
          <li>Run <code>run</code> and <code>check</code> commands from the gutter, with their results directly
              visible as inlay hints, and the full analyzer output as a tooltip</li>
          <li>The <em>Alloy Instance</em> tool window: instances and counterexamples as a graph, text or table,
              with dedicated support for traces and state changes</li>
          <li>An evaluator for expressions and formulas over the shown instance, at the selected state of a trace,
              with completion of the model's names, atoms and skolems, and watches that follow the state, as in
              the debugger</li>
        </ul>
        <p>Solvers: the pure-Java SAT4J variants, and Yices, Plingeling and Electrod when their executables are on
        the <code>PATH</code>. Known limitations: solvers that need a native library are not available, and
        analyses use the IDE's memory, so models with very large scopes are better run in the Alloy desktop
        application.</p>
        ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <dependencies>
        <module name="intellij.platform.smRunner"/>
    </dependencies>
    <resource-bundle>messages.AlloyBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Alloy" language="Alloy" extensions="als"
                  implementationClass="com.serranofp.alloy.AlloyFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="Alloy"
                               implementationClass="com.serranofp.alloy.parser.AlloyParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Alloy"
                                       implementationClass="com.serranofp.alloy.highlighting.AlloySyntaxHighlighterFactory"/>
        <lang.braceMatcher language="Alloy" implementationClass="com.serranofp.alloy.editor.AlloyBraceMatcher"/>
        <lang.commenter language="Alloy" implementationClass="com.serranofp.alloy.editor.AlloyCommenter"/>
        <lang.foldingBuilder language="Alloy" implementationClass="com.serranofp.alloy.editor.AlloyFoldingBuilder"/>
        <completion.contributor language="Alloy"
                                implementationClass="com.serranofp.alloy.editor.AlloyKeywordCompletionContributor"/>
        <completion.contributor language="Alloy"
                                implementationClass="com.serranofp.alloy.editor.AlloyCompletionContributor"/>
        <completion.contributor language="Alloy"
                                implementationClass="com.serranofp.alloy.viewer.AlloyEvaluatorCompletionContributor"/>
        <stubElementTypeHolder class="com.serranofp.alloy.psi.AlloyTypes" externalIdPrefix="alloy."/>
        <stubIndex implementation="com.serranofp.alloy.psi.stubs.AlloyNameIndex"/>
        <lang.findUsagesProvider language="Alloy" implementationClass="com.serranofp.alloy.semantics.AlloyFindUsagesProvider"/>
        <usageTypeProvider implementation="com.serranofp.alloy.semantics.AlloyUsageTypeProvider"/>
        <renamePsiElementProcessor implementation="com.serranofp.alloy.semantics.AlloyRenameProcessor"/>
        <lang.refactoringSupport language="Alloy" implementationClass="com.serranofp.alloy.semantics.AlloyRefactoringSupportProvider"/>
        <lang.documentationProvider language="Alloy" implementationClass="com.serranofp.alloy.semantics.AlloyDocumentationProvider"/>
        <lang.psiStructureViewFactory language="Alloy" implementationClass="com.serranofp.alloy.editor.AlloyStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.serranofp.alloy.editor.AlloyBreadcrumbsProvider"/>
        <gotoSymbolContributor implementation="com.serranofp.alloy.semantics.AlloySymbolContributor"/>
        <additionalLibraryRootsProvider implementation="com.serranofp.alloy.semantics.AlloyLibraryRootsProvider"/>
        <toolWindow id="Alloy Instance" anchor="right" icon="/icons/alloy.svg" doNotActivateOnStart="true"
                    factoryClass="com.serranofp.alloy.viewer.AlloyInstanceToolWindowFactory"/>
        <externalAnnotator language="Alloy" implementationClass="com.serranofp.alloy.semantics.AlloyExternalAnnotator"/>
        <highlightErrorFilter implementation="com.serranofp.alloy.viewer.AlloyEvaluatorErrorFilter"/>
        <localInspection language="Alloy" shortName="AlloyUnscopedMutableSignature" groupName="Alloy"
                         bundle="messages.AlloyBundle" key="inspection.unscoped.mutable.signature.name"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.serranofp.alloy.inspections.AlloyUnscopedMutableSignatureInspection"/>
        <localInspection language="Alloy" shortName="AlloyExactParameterScope" groupName="Alloy"
                         bundle="messages.AlloyBundle" key="inspection.exact.parameter.scope.name"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.serranofp.alloy.inspections.AlloyExactParameterScopeInspection"/>
        <localInspection language="Alloy" shortName="AlloySeqBoundTooSmall" groupName="Alloy"
                         bundle="messages.AlloyBundle" key="inspection.seq.bound.too.small.name"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.serranofp.alloy.inspections.AlloySeqBoundTooSmallInspection"/>
        <localInspection language="Alloy" shortName="AlloyMissingFrameCondition" groupName="Alloy"
                         bundle="messages.AlloyBundle" key="inspection.missing.frame.condition.name"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.serranofp.alloy.inspections.AlloyMissingFrameConditionInspection"/>
        <lang.inspectionSuppressor language="Alloy" implementationClass="com.serranofp.alloy.inspections.AlloyInspectionSuppressor"/>
        <codeInsight.declarativeInlayProvider language="Alloy" group="OTHER_GROUP" isEnabledByDefault="true"
                                              providerId="alloy.command.results"
                                              bundle="messages.AlloyBundle"
                                              nameKey="inlay.command.results.name"
                                              descriptionKey="inlay.command.results.description"
                                              implementationClass="com.serranofp.alloy.run.AlloyCommandResultHintsProvider"/>
        <codeInsight.inlayActionHandler handlerId="alloy.command.result"
                                        implementationClass="com.serranofp.alloy.run.AlloyCommandResultClickHandler"/>
        <editorFactoryMouseListener implementation="com.serranofp.alloy.run.AlloyCommandResultMouseListener"/>
        <runLineMarkerContributor language="Alloy" implementationClass="com.serranofp.alloy.run.AlloyRunLineMarkerContributor"/>
        <configurationType implementation="com.serranofp.alloy.run.tests.AlloyCommandsConfigurationType"/>
        <runConfigurationProducer implementation="com.serranofp.alloy.run.tests.AlloyCommandsConfigurationProducer"/>
        <applicationConfigurable parentId="language" id="com.serranofp.alloy.settings" displayName="Alloy"
                                 instance="com.serranofp.alloy.settings.AlloySettingsConfigurable"/>
        <colorSettingsPage implementation="com.serranofp.alloy.highlighting.AlloyColorSettingsPage"/>
    </extensions>
</idea-plugin>
