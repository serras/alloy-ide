{
  parserClass="com.serranofp.alloy.parser.AlloyParser"
  elementTypeHolderClass="com.serranofp.alloy.psi.AlloyTypes"
  elementTypeClass="com.serranofp.alloy.psi.AlloyElementType"
  tokenTypeClass="com.serranofp.alloy.psi.AlloyTokenType"
  psiPackage="com.serranofp.alloy.psi"
  psiImplPackage="com.serranofp.alloy.psi.impl"

  // Token names follow upstream CompSym where they are unambiguous;
  // symbolic spellings of word operators (`&&` vs `and`) get their own token
  tokens=[
    // Symbols
    EXCL='!'
    HASH='#'
    AMPAMP='&&'
    AMPERSAND='&'
    LPAREN='('
    RPAREN=')'
    STAR='*'
    PLUSPLUS='++'
    PLUS='+'
    COMMA=','
    ARROW='->'
    MINUS='-'
    DOT='.'
    SLASH='/'
    COLONCOLON='::'
    RANGE=':>'
    COLON=':'
    IFF_ARROW='<=>'
    LTE='<='
    DOMAIN='<:'
    SHL='<<'
    LT='<'
    EQLT='=<'
    IMPLIES_ARROW='=>'
    EQUALS='='
    SHR='>>>'
    SHA='>>'
    GTE='>='
    GT='>'
    AT='@'
    LBRACKET='['
    RBRACKET=']'
    CARET='^'
    LBRACE='{'
    BARBAR='||'
    BAR='|'
    RBRACE='}'
    TILDE='~'
    SEMICOLON=';'
    PRIME="'"

    // Keywords
    ABSTRACT='abstract'
    ALL='all'
    AND='and'
    ASSERT='assert'
    AS='as'
    BUT='but'
    CHECK='check'
    DISJOINT='disjoint'
    DISJ='disj'
    ELSE='else'
    ENUM='enum'
    EXACTLY='exactly'
    EXPECT='expect'
    EXTENDS='extends'
    FACT='fact'
    FOR='for'
    FUN='fun'
    IDEN='iden'
    IFF='iff'
    IMPLIES='implies'
    SIGINT='Int'
    INT='int'
    IN='in'
    LET='let'
    LONE='lone'
    MODULE='module'
    NONE='none'
    NOT='not'
    NO='no'
    ONE='one'
    OPEN='open'
    OR='or'
    PRED='pred'
    PRIVATE='private'
    RUN='run'
    SEQ='seq'
    SET='set'
    SIG='sig'
    SOME='some'
    STRING='String'
    SUM='sum'
    THIS='this'
    UNIV='univ'
    VAR='var'
    STEPS='steps'

    // Temporal keywords
    ALWAYS='always'
    AFTER='after'
    EVENTUALLY='eventually'
    HISTORICALLY='historically'
    BEFORE='before'
    ONCE='once'
    RELEASES='releases'
    UNTIL='until'
    SINCE='since'
    TRIGGERED='triggered'

    // Literals and comments
    IDENTIFIER='regexp:[\p{javaJavaIdentifierStart}][\p{javaJavaIdentifierPart}"]*'
    NUMBER='regexp:\d[\d_]*'
    STRING_LITERAL='regexp:"([^\\"]|\\.)*"'
    LINE_COMMENT='regexp:(//|--)[^\r\n]*'
    BLOCK_COMMENT='regexp:/\*([^*]|\*+[^*/])*\*+/'
    DOC_COMMENT='regexp:/\*\*([^*]|\*+[^*/])*\*+/'
  ]
}

// Placeholder: replaced by the paragraph grammar.
alloyFile ::= IDENTIFIER*
